{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated campus user profile storing student or organizer identity and department.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full display name of the student or organizer."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150,
          "description": "Verified campus or Google email address."
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Profile avatar URL."
        },
        "department": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Academic department or student club affiliation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": ["uid", "displayName", "email", "photoURL", "department", "createdAt", "updatedAt"]
    },
    "CampusEvent": {
      "title": "CampusEvent",
      "description": "A published college campus event created by an organizer.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Title of the campus event."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000,
          "description": "Detailed description, agenda, and guidelines."
        },
        "category": {
          "type": "string",
          "enum": ["Technology", "Academic", "Cultural", "Sports", "Career", "Workshop"],
          "description": "Event category classification."
        },
        "venue": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150,
          "description": "Campus building, auditorium, or field location."
        },
        "eventDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Scheduled date in YYYY-MM-DD format."
        },
        "eventTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Scheduled start time in 24h HH:MM format."
        },
        "startAtMs": {
          "type": "number",
          "description": "Unix epoch milliseconds of event start for chronological sorting."
        },
        "capacity": {
          "type": "integer",
          "description": "Maximum allowed participant registrations (1 to 5000)."
        },
        "registeredCount": {
          "type": "integer",
          "description": "Current confirmed participant count."
        },
        "organizerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Immutable Firebase Auth UID of the event creator."
        },
        "organizerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Public display name of the event organizer."
        },
        "status": {
          "type": "string",
          "enum": ["published"],
          "description": "Publication status of the campus event."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of event creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last event update."
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "venue",
        "eventDate",
        "eventTime",
        "startAtMs",
        "capacity",
        "registeredCount",
        "organizerId",
        "organizerName",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "EventRegistration": {
      "title": "EventRegistration",
      "description": "Protected student registration record linking a verified student to a campus event.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target CampusEvent document ID."
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated student Firebase Auth UID."
        },
        "organizerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Denormalized organizer UID verified against the parent event."
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Full name of the registered student."
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150,
          "description": "Protected email address visible only to the student and event organizer."
        },
        "department": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Student academic department or year."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Optional dietary, accessibility, or team note."
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of registration."
        }
      },
      "required": [
        "eventId",
        "studentId",
        "organizerId",
        "studentName",
        "studentEmail",
        "department",
        "notes",
        "registeredAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents strictly isolated to the owning user."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampusEvent" },
      "description": "Published campus events browsable by authenticated users and editable only by their creator."
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/EventRegistration" },
      "description": "Deterministic student registrations ({eventId}_{studentId}) readable only by the student or the event organizer."
    }
  }
}
