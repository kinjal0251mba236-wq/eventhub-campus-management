rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared hardened primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'department', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'department', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.department is string && data.department.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEventCategory(cat) {
      return cat in ['Technology', 'Academic', 'Cultural', 'Sports', 'Career', 'Workshop'];
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
          'title', 'description', 'category', 'venue',
          'eventDate', 'eventTime', 'startAtMs', 'capacity',
          'registeredCount', 'organizerId', 'organizerName', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'category', 'venue',
          'eventDate', 'eventTime', 'startAtMs', 'capacity',
          'registeredCount', 'organizerId', 'organizerName', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 2000
        && data.category is string && isValidEventCategory(data.category)
        && data.venue is string && data.venue.size() >= 2 && data.venue.size() <= 150
        && data.eventDate is string && data.eventDate.size() == 10 && data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.eventTime is string && data.eventTime.size() == 5 && data.eventTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.startAtMs is number && data.startAtMs > 0
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 5000
        && data.registeredCount is int && data.registeredCount >= 0 && data.registeredCount <= data.capacity
        && isValidId(data.organizerId)
        && data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 100
        && data.status is string && data.status == 'published'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll([
          'eventId', 'studentId', 'organizerId',
          'studentName', 'studentEmail', 'department', 'notes', 'registeredAt'
        ])
        && data.keys().hasOnly([
          'eventId', 'studentId', 'organizerId',
          'studentName', 'studentEmail', 'department', 'notes', 'registeredAt'
        ])
        && isValidId(data.eventId)
        && isValidId(data.studentId)
        && isValidId(data.organizerId)
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100
        && data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 150
        && data.department is string && data.department.size() <= 100
        && data.notes is string && data.notes.size() <= 300
        && data.registeredAt is timestamp;
    }

    // 1. Private User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'department', 'updatedAt']);
      allow delete: if false;
    }

    // 2. Campus Events
    match /events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId);
      allow list: if isSignedIn() && resource.data.status == 'published';

      allow create: if isVerifiedUser()
        && isValidId(eventId)
        && isValidEvent(incoming())
        && incoming().organizerId == request.auth.uid
        && incoming().registeredCount == 0
        && incoming().status == 'published'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(eventId)
        && isValidEvent(incoming())
        && incoming().organizerId == existing().organizerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action A: Event organizer updates event details
          (
            existing().organizerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'category', 'venue',
              'eventDate', 'eventTime', 'startAtMs', 'capacity',
              'organizerName', 'updatedAt'
            ])
            && incoming().capacity >= existing().registeredCount
          )
          ||
          // Action B: Authenticated student atomically registers (+1)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['registeredCount', 'updatedAt'])
            && incoming().registeredCount == existing().registeredCount + 1
            && incoming().registeredCount <= existing().capacity
            && !exists(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid))
          )
          ||
          // Action C: Authenticated student atomically unregisters (-1)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['registeredCount', 'updatedAt'])
            && incoming().registeredCount == existing().registeredCount - 1
            && incoming().registeredCount >= 0
            && exists(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid))
            && !existsAfter(/databases/$(database)/documents/registrations/$(eventId + '_' + request.auth.uid))
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(eventId)
        && existing().organizerId == request.auth.uid;
    }

    // 3. Protected Event Registrations
    match /registrations/{registrationId} {
      allow get: if isSignedIn()
        && isValidId(registrationId)
        && (existing().studentId == request.auth.uid || existing().organizerId == request.auth.uid);

      allow list: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || resource.data.organizerId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(registrationId)
        && isValidRegistration(incoming())
        && registrationId == (incoming().eventId + '_' + request.auth.uid)
        && incoming().studentId == request.auth.uid
        && incoming().registeredAt == request.time
        && exists(/databases/$(database)/documents/events/$(incoming().eventId))
        && get(/databases/$(database)/documents/events/$(incoming().eventId)).data.organizerId == incoming().organizerId
        && getAfter(/databases/$(database)/documents/events/$(incoming().eventId)).data.registeredCount
           == get(/databases/$(database)/documents/events/$(incoming().eventId)).data.registeredCount + 1;

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidId(registrationId)
        && (
          // Student unregisters atomically with -1 on event
          (
            existing().studentId == request.auth.uid
            && exists(/databases/$(database)/documents/events/$(existing().eventId))
            && getAfter(/databases/$(database)/documents/events/$(existing().eventId)).data.registeredCount
               == get(/databases/$(database)/documents/events/$(existing().eventId)).data.registeredCount - 1
          )
          ||
          // Event organizer cleans up registrations when deleting the parent event atomically
          (
            existing().organizerId == request.auth.uid
            && !existsAfter(/databases/$(database)/documents/events/$(existing().eventId))
          )
        );
    }
  }
}
